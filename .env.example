FINTRACK_DEVELOPMENT_AUTH=false

# Free Nemotron financial analyst through OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
CRON_SECRET=